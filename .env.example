# open-slide-server settings. Copy to .env (setup.sh does this for you).

# The address you open in the browser (no trailing slash). Everything lives on this one host:
#   /  start page   /editor/  editor   /slides/  published decks   /share/<token>/  share links
PUBLIC_URL=https://slides.example.com

# Where the gateway listens on this machine. It does NO login itself: your reverse proxy in front
# must require login for everything except /share/ (docs/ingress.md). Keep 127.0.0.1 unless that
# proxy runs on another machine.
BIND=127.0.0.1
PORT=8080

# Internet for the editor / Claude agent (web fetch, MCP servers, plugins, npm install):
#   on : through a filtering proxy, public addresses only (never your host or LAN). Your Claude and
#        GitHub tokens stay protected either way, but code from a repo you open could send that
#        project's contents to the internet. Only open repos you trust.
#   off: no internet in the editor (Claude's web search still works; it runs on Anthropic's side).
EDITOR_INTERNET=on

# GitHub sync + publishing interval in seconds.
CYCLE_SECONDS=120

# Image version (default: latest from ghcr.io). Set e.g. OPEN_SLIDE_VERSION=local and run
# `docker compose build` to use images built from this checkout instead.
#OPEN_SLIDE_VERSION=latest
